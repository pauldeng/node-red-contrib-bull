[
  {
    "id": "flow-postgres-backend",
    "type": "tab",
    "label": "PostgreSQL backend",
    "disabled": false,
    "info": ""
  },
  {
    "id": "queue-postgres-backend",
    "type": "bullmq-queue-server",
    "name": "pgcasts",
    "backend": "postgres",
    "address": "localhost",
    "port": "5432",
    "database": "bullmq",
    "username": "bullmq",
    "schema": "",
    "max": "",
    "migrate": true,
    "tls": false,
    "tlsRejectUnauthorized": true,
    "tlsServerName": "",
    "removeOnComplete": "1000",
    "removeOnFail": "5000",
    "deployment": "single",
    "db": "",
    "clusterNodes": "",
    "sentinels": "",
    "sentinelMasterName": "",
    "sentinelUsername": "",
    "sentinelTls": false,
    "prefix": "",
    "telemetry": false,
    "telemetryServiceName": "",
    "telemetryMetrics": false
  },
  {
    "id": "inject-postgres-add",
    "type": "inject",
    "z": "flow-postgres-backend",
    "name": "postgres: add a job",
    "props": [
      {
        "p": "payload"
      }
    ],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "order-1",
    "payloadType": "str",
    "x": 180,
    "y": 120,
    "wires": [["fn-postgres-add"]]
  },
  {
    "id": "fn-postgres-add",
    "type": "function",
    "z": "flow-postgres-backend",
    "name": "add order job",
    "func": "// Nothing here is PostgreSQL-specific: the same msg.cmd values, job options\n// and worker messages work on either backend. Only the queue config node\n// differs, which is the point of this example.\nmsg.cmd = \"add\";\nmsg.payload = { orderId: msg.payload || \"order-1\", stage: \"received\" };\nmsg.jobopts = { removeOnComplete: 1000, removeOnFail: 5000 };\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 420,
    "y": 120,
    "wires": [["cmd-postgres-backend"]]
  },
  {
    "id": "cmd-postgres-backend",
    "type": "bullmq cmd",
    "z": "flow-postgres-backend",
    "name": "queue command",
    "queue": "queue-postgres-backend",
    "x": 680,
    "y": 120,
    "wires": [["debug-postgres-command"]]
  },
  {
    "id": "debug-postgres-command",
    "type": "debug",
    "z": "flow-postgres-backend",
    "name": "command output",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 900,
    "y": 120,
    "wires": []
  },
  {
    "id": "run-postgres-backend",
    "type": "bullmq run",
    "z": "flow-postgres-backend",
    "name": "order worker",
    "queue": "queue-postgres-backend",
    "completionMode": "immediate",
    "ackTimeout": 300000,
    "concurrency": 1,
    "maxStartedAttempts": 100,
    "limiterMax": "",
    "limiterDuration": "",
    "x": 180,
    "y": 260,
    "wires": [["fn-postgres-worker"]]
  },
  {
    "id": "fn-postgres-worker",
    "type": "function",
    "z": "flow-postgres-backend",
    "name": "handle order",
    "func": "// The worker receives the job's data as msg.payload, exactly as it does on\n// Redis.\nmsg.topic = msg.payload.stage;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 420,
    "y": 260,
    "wires": [["debug-postgres-worker"]]
  },
  {
    "id": "debug-postgres-worker",
    "type": "debug",
    "z": "flow-postgres-backend",
    "name": "processed order",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": true,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "topic",
    "statusType": "msg",
    "x": 660,
    "y": 260,
    "wires": []
  }
]
